000000000111\",\n    \"1111000000001111\",\n    \"0111110000111110\",\n    \"0110110000111110\",\n    \"0011000000111100\",\n    \"0001110000111000\",\n    \"0000010000100000\",\n  ],\n} as const;\n\nexport type PixelIconName = keyof typeof ICONS;\n\n/**\n * A custom pixel grid: one string per row, `\"1\"` = filled pixel.\n * Any size works (built-ins are 7x7, github is 16x16). Keep rows the same\n * length — ragged rows render left-aligned against the widest row.\n */\nexport type PixelIconGrid = readonly string[];\n\n/** Anything PixelIcon and the `icon` prop accept: a registry name or your own grid. */\nexport type PixelIconInput = PixelIconName | PixelIconGrid;\n\n/**\n * Normalize a name-or-grid into renderable rows.\n * Unknown names resolve to `undefined` (renders nothing, never crashes).\n */\nexport function resolvePixelGrid(\n  input: PixelIconInput | undefined | null\n): readonly string[] | undefined {\n  if (!input) return undefined;\n  if (typeof input !== \"string\") return input;\n  return (ICONS as Record<string, readonly string[]>)[input];\n}\n\nexport function PixelIcon({\n  name,\n  grid,\n  icon,\n  size = \"md\",\n  variant = \"primary\",\n  className,\n}: {\n  /** Registry icon name. Kept for back-compat — `icon` does the same plus custom grids. */\n  name?: PixelIconName;\n  /** Custom pixel grid. Wins over `icon`/`name` when provided. */\n  grid?: PixelIconGrid;\n  /** Registry name or custom grid. Wins over `name` when provided. */\n  icon?: PixelIconInput;\n  size?: \"sm\" | \"md\" | \"lg\";\n  variant?: \"primary\" | \"dark\";\n  className?: string;\n}) {\n  const resolved =\n    grid ??\n    (icon !== undefined ? resolvePixelGrid(icon) : undefined) ??\n    (name ? ICONS[name] : undefined);\n  if (!resolved || resolved.length === 0) return null;\n  const cols = Math.max(...resolved.map((r) => r.length));\n  const rows = resolved.length;\n  return (\n    <svg\n      data-size={size}\n      data-variant={variant}\n      className={\n        \"bricked-icon block shrink-0\" + (className ? ` ${className}` : \"\")\n      }\n      style={{\n        width: `calc(var(--icon, 4px) * ${cols})`,\n        height: `calc(var(--icon, 4px) * ${rows})`,\n      }}\n      viewBox={`0 0 ${cols} ${rows}`}\n      shapeRendering=\"crispEdges\"\n      aria-hidden=\"true\"\n    >\n      {resolved.flatMap((row, y) =>\n        [...row].map((cell, x) =>\n          cell === \"1\" ? (\n            <rect key={`${x}-${y}`} x={x} y={y} width={1} height={1} fill=\"currentColor\" />\n          ) : null\n        )\n      )}\n    </svg>\n  );\n}",
