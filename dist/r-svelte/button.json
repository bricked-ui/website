{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "button",
  "type": "registry:ui",
  "title": "Button",
  "description": "Brick button + square icon-button variant. sm/md/lg, primary/dark, left/right icon slots.",
  "registryDependencies": [
    "./pixel-icon.json"
  ],
  "files": [
    {
      "content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import PixelIcon from \"./pixel-icon.svelte\";\n  import type { PixelIconInput } from \"./icons.js\";\n  import { cn } from \"$UTILS$.js\";\n\n  interface Props {\n    size?: \"sm\" | \"md\" | \"lg\";\n    icon?: PixelIconInput;\n    iconPosition?: \"left\" | \"right\";\n    type?: \"button\" | \"submit\" | \"reset\";\n    disabled?: boolean;\n    class?: string;\n    onclick?: (e: MouseEvent) => void;\n    children: Snippet;\n    [key: string]: unknown;\n  }\n\n  let {\n    size = \"md\",\n    icon,\n    iconPosition = \"left\",\n    type = \"button\",\n    disabled = false,\n    class: cls = \"\",\n    onclick,\n    children,\n    ...rest\n  }: Props = $props();\n</script>\n\n<button\n  {type}\n  {disabled}\n  class={cn(\"bricked-btn\", size !== \"md\" && `bricked-btn--${size}`, cls)}\n  {onclick}\n  {...rest}\n>\n  {#if icon && iconPosition === \"left\"}\n    <PixelIcon icon={icon} />\n  {/if}\n  <span>{@render children()}</span>\n  {#if icon && iconPosition === \"right\"}\n    <PixelIcon icon={icon} />\n  {/if}\n</button>\n",
      "type": "registry:ui",
      "target": "button.svelte"
    },
    {
      "content": "<script lang=\"ts\">\n  import PixelIcon from \"./pixel-icon.svelte\";\n  import type { PixelIconInput } from \"./icons.js\";\n  import { cn } from \"$UTILS$.js\";\n\n  interface Props {\n    icon: PixelIconInput;\n    label: string;\n    dot?: boolean;\n    class?: string;\n    onclick?: (e: MouseEvent) => void;\n  }\n  let { icon, label, dot = false, class: cls = \"\", onclick, ...rest }: Props = $props();\n</script>\n\n<button type=\"button\" aria-label={label} class={cn(\"bk-ibtn bk-cut\", cls)} {onclick} {...rest}>\n  <PixelIcon icon={icon} />\n  {#if dot}\n    <span class=\"bk-ibtn__dot\" aria-hidden=\"true\"></span>\n  {/if}\n</button>\n",
      "type": "registry:ui",
      "target": "icon-button.svelte"
    }
  ]
}
