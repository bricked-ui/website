{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "avatar",
  "type": "registry:ui",
  "title": "Avatar",
  "description": "Orange or dark 48px avatar.",
  "registryDependencies": [
    "./pixel-icon.json"
  ],
  "files": [
    {
      "content": "<script lang=\"ts\">\n  import PixelIcon from \"./pixel-icon.svelte\";\n\n  interface Props {\n    icon?: import(\"./icons.js\").PixelIconInput;\n    dark?: boolean;\n    children?: import(\"svelte\").Snippet;\n  }\n  let { icon, dark = false, children }: Props = $props();\n</script>\n\n<span class=\"bk-avatar bk-cut\" class:bk-avatar--dark={dark}>\n  {#if icon}<PixelIcon icon={icon} />\n  {:else if children}{@render children()}\n  {/if}\n</span>\n",
      "type": "registry:ui",
      "target": "avatar.svelte"
    }
  ]
}
