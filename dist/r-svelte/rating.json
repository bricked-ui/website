{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "rating",
  "type": "registry:ui",
  "title": "Rating",
  "description": "Five star radio buttons.",
  "registryDependencies": [
    "./bricked-css.json",
    "./pixel-icon.json"
  ],
  "files": [
    {
      "content": "<script lang=\"ts\">\n  import PixelIcon from \"./pixel-icon.svelte\";\n\n  interface Props {\n    value?: number;\n    onChange?: (v: number) => void;\n  }\n  let { value = $bindable(0), onChange }: Props = $props();\n</script>\n\n<div class=\"bk-rate\" role=\"radiogroup\" aria-label=\"Rating\">\n  {#each [1, 2, 3, 4, 5] as n}\n    <button\n      type=\"button\"\n      role=\"radio\"\n      aria-checked={value === n}\n      aria-label=\"{n} stars\"\n      class:is-on={n <= value}\n      onclick={() => {\n        value = n;\n        onChange?.(n);\n      }}\n    >\n      <PixelIcon name=\"star\" />\n    </button>\n  {/each}\n</div>\n\n<style>\n  .is-on {\n    color: var(--ink);\n  }\n</style>\n",
      "type": "registry:ui",
      "target": "rating.svelte"
    }
  ]
}
