{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "tabs",
  "type": "registry:ui",
  "title": "Tabs",
  "description": "Brick tabs with sunken field panel.",
  "files": [
    {
      "content": "<script lang=\"ts\">\n  interface Props {\n    items: string[];\n    value?: string;\n    onChange?: (t: string) => void;\n  }\n  let { items, value = $bindable(items[0]), onChange }: Props = $props();\n</script>\n\n<div class=\"bk-tabs\" role=\"tablist\">\n  {#each items as t}\n    <button\n      type=\"button\"\n      role=\"tab\"\n      aria-selected={value === t}\n      class=\"bk-tab bk-cut\"\n      onclick={() => {\n        value = t;\n        onChange?.(t);\n      }}\n    >\n      {t}\n    </button>\n  {/each}\n</div>\n",
      "type": "registry:ui",
      "target": "tabs.svelte"
    }
  ]
}
