{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "ring-loader",
  "type": "registry:ui",
  "title": "Ring loader",
  "description": "Blinking 8-cube ring, plain or with label.",
  "files": [
    {
      "content": "<script lang=\"ts\">\n  interface Props {\n    label?: string;\n  }\n  let { label = \"Loading\" }: Props = $props();\n  const RING: Array<[number, number]> = [[1, 1], [1, 2], [1, 3], [2, 3], [3, 3], [3, 2], [3, 1], [2, 1]];\n</script>\n\n<span class=\"bk-spin-wrap\" role=\"status\">\n  <span class=\"bk-brick-spin\" aria-hidden=\"true\">\n    {#each RING as [r, c], i}\n      <span style=\"grid-row: {r}; grid-column: {c}; animation-delay: {i * 0.1}s\"></span>\n    {/each}\n  </span>\n  {label}\n</span>\n",
      "type": "registry:ui",
      "target": "ring-loader.svelte"
    }
  ]
}
