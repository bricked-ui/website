{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "accordion",
  "type": "registry:ui",
  "title": "Accordion",
  "description": "Field headers, orange when open.",
  "registryDependencies": [
    "./bricked-css.json",
    "./pixel-icon.json"
  ],
  "files": [
    {
      "content": "<script lang=\"ts\">\n  import type { Snippet } from \"svelte\";\n  import PixelIcon from \"./pixel-icon.svelte\";\n\n  interface Item {\n    title: string;\n    body: string | Snippet;\n  }\n  interface Props {\n    items: Item[];\n    open?: number;\n    onToggle?: (i: number) => void;\n  }\n  let { items, open = $bindable(0), onToggle }: Props = $props();\n</script>\n\n<div class=\"bk-acc\">\n  {#each items as it, i}\n    <div>\n      <button\n        type=\"button\"\n        aria-expanded={open === i}\n        class=\"bk-acc__btn bk-cut\"\n        onclick={() => {\n          open = open === i ? -1 : i;\n          onToggle?.(open);\n        }}\n      >\n        {it.title}\n        <PixelIcon name=\"down\" />\n      </button>\n      {#if open === i}\n        {#if typeof it.body === \"string\"}\n          <p class=\"bk-acc__body\">{it.body}</p>\n        {:else}\n          <div class=\"bk-acc__body\">{@render it.body()}</div>\n        {/if}\n      {/if}\n    </div>\n  {/each}\n</div>\n",
      "type": "registry:ui",
      "target": "accordion.svelte"
    }
  ]
}
