{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "calendar",
  "type": "registry:ui",
  "title": "Calendar",
  "description": "Month grid with selected day.",
  "files": [
    {
      "content": "<script lang=\"ts\">\n  interface Props {\n    value?: number;\n    onchange?: (d: number) => void;\n  }\n  let { value = $bindable(15), onchange }: Props = $props();\n  const cells: Array<number | null> = [null, null, null, ...Array.from({ length: 31 }, (_, i) => i + 1)];\n</script>\n\n<div class=\"bk-cal bk-cut\">\n  <p class=\"bk-cal__title\">October 2026</p>\n  <div class=\"bk-cal__grid\">\n    {#each [\"M\", \"T\", \"W\", \"T\", \"F\", \"S\", \"S\"] as d}\n      <span class=\"bk-cal__dow\">{d}</span>\n    {/each}\n    {#each cells as d, i}\n      {#if d === null}\n        <span></span>\n      {:else}\n        <button\n          type=\"button\"\n          aria-pressed={d === value}\n          class=\"bk-day\"\n          class:is-on={d === value}\n          onclick={() => {\n            value = d;\n            onchange?.(d);\n          }}>{d}</button\n        >\n      {/if}\n    {/each}\n  </div>\n</div>\n",
      "type": "registry:ui",
      "target": "calendar.svelte"
    }
  ]
}
