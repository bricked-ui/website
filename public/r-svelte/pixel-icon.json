{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "pixel-icon",
  "type": "registry:ui",
  "title": "Pixel Icon",
  "description": "20 crisp 7x7 pixel icons as SVG rects. Every component takes one via the icon prop.",
  "files": [
    {
      "content": "<script lang=\"ts\">\n  import { ICONS, type PixelIconName } from \"./icons.js\";\n\n  interface Props {\n    name: PixelIconName;\n    class?: string;\n  }\n\n  let { name, class: cls = \"\" }: Props = $props();\n\n  const grid = $derived(ICONS[name]);\n  const cols = $derived(grid[0].length);\n  const rows = $derived(grid.length);\n</script>\n\n<svg\n  class=\"bricked-icon {cls}\"\n  style=\"width: calc(var(--icon, 4px) * {cols}); height: calc(var(--icon, 4px) * {rows});\"\n  viewBox=\"0 0 {cols} {rows}\"\n  shape-rendering=\"crispEdges\"\n  aria-hidden=\"true\"\n>\n  {#each grid as row, y}\n    {#each [...row] as cell, x}\n      {#if cell === \"1\"}\n        <rect x={x} y={y} width={1} height={1} fill=\"currentColor\" />\n      {/if}\n    {/each}\n  {/each}\n</svg>\n",
      "type": "registry:ui",
      "target": "pixel-icon.svelte"
    },
    {
      "content": "export const ICONS = {\n  play: [\"1000000\", \"1100000\", \"1110000\", \"1111000\", \"1110000\", \"1100000\", \"1000000\"],\n  plus: [\"0001000\", \"0001000\", \"0001000\", \"1111111\", \"0001000\", \"0001000\", \"0001000\"],\n  minus: [\"0000000\", \"0000000\", \"0000000\", \"1111111\", \"0000000\", \"0000000\", \"0000000\"],\n  check: [\"0000001\", \"0000011\", \"0000110\", \"1001100\", \"1111000\", \"0110000\", \"0010000\"],\n  arrow: [\"0001000\", \"0001100\", \"1111110\", \"1111111\", \"1111110\", \"0001100\", \"0001000\"],\n  heart: [\"0110110\", \"1111111\", \"1111111\", \"0111110\", \"0011100\", \"0001000\", \"0000000\"],\n  star: [\"0001000\", \"0001000\", \"1111111\", \"0111110\", \"0011100\", \"0110110\", \"0100010\"],\n  download: [\"0001000\", \"0001000\", \"1001001\", \"0101010\", \"0011100\", \"0001000\", \"1111111\"],\n  upload: [\"0001000\", \"0011100\", \"0101010\", \"0001000\", \"0001000\", \"0001000\", \"1111111\"],\n  home: [\"0001000\", \"0011100\", \"0111110\", \"1111111\", \"0111110\", \"0110110\", \"0110110\"],\n  rocket: [\"0001000\", \"0011100\", \"0010100\", \"0011100\", \"0111110\", \"1101011\", \"0001000\"],\n  cart: [\"1100000\", \"0100000\", \"0111111\", \"0111110\", \"0011100\", \"0010010\", \"0000000\"],\n  dot: [\"0011100\", \"0111110\", \"1111111\", \"1111111\", \"1111111\", \"0111110\", \"0011100\"],\n  down: [\"0000000\", \"0000000\", \"1100011\", \"0110110\", \"0011100\", \"0001000\", \"0000000\"],\n  right: [\"0100000\", \"0010000\", \"0001000\", \"0000100\", \"0001000\", \"0010000\", \"0100000\"],\n  left: [\"0000010\", \"0000100\", \"0001000\", \"0010000\", \"0001000\", \"0000100\", \"0000010\"],\n  alert: [\"0001000\", \"0001000\", \"0001000\", \"0001000\", \"0001000\", \"0000000\", \"0001000\"],\n  close: [\"1000001\", \"0100010\", \"0010100\", \"0001000\", \"0010100\", \"0100010\", \"1000001\"],\n  user: [\"0011100\", \"0111110\", \"0111110\", \"0011100\", \"0000000\", \"1111111\", \"1111111\"],\n  search: [\"0111000\", \"1000100\", \"1000100\", \"1000100\", \"0111010\", \"0000101\", \"0000010\"],\n  code: [\"0000000\", \"0010100\", \"0100010\", \"1000001\", \"0100010\", \"0010100\", \"0000000\"],\n  // Exception: GitHub mark needs 16x16 to read. PixelIcon sizes from the grid so mixed sizes work.\n  github: [\n    \"0000011111100000\",\n    \"0001111111111000\",\n    \"0011111111111100\",\n    \"0111011111101110\",\n    \"0111000000001110\",\n    \"1111000000001111\",\n    \"1110000000000111\",\n    \"1110000000000111\",\n    \"1110000000000111\",\n    \"1110000000000111\",\n    \"1111000000001111\",\n    \"0111110000111110\",\n    \"0110110000111110\",\n    \"0011000000111100\",\n    \"0001110000111000\",\n    \"0000010000100000\"\n  ]\n} as const;\n\nexport type PixelIconName = keyof typeof ICONS;\n",
      "type": "registry:ui",
      "target": "icons.ts"
    }
  ]
}
