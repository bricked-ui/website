{
  "$schema": "https://shadcn-svelte.com/schema/registry-item.json",
  "name": "dropdown-menu",
  "type": "registry:ui",
  "title": "Dropdown menu",
  "description": "Trigger plus dark menu list.",
  "registryDependencies": [
    "./button.json",
    "./pixel-icon.json"
  ],
  "files": [
    {
      "content": "<script lang=\"ts\">\n  import PixelIcon from \"./pixel-icon.svelte\";\n  import Button from \"./button.svelte\";\n\n  interface Props {\n    label: string;\n    items: string[];\n    onPick?: (it: string) => void;\n  }\n  let { label, items, onPick }: Props = $props();\n  let open = $state(false);\n  let ref: HTMLDivElement | undefined = $state(undefined);\n\n  $effect(() => {\n    if (!open) return;\n    const away = (e: MouseEvent) => {\n      if (ref && !ref.contains(e.target as Node)) open = false;\n    };\n    const esc = (e: KeyboardEvent) => {\n      if (e.key === \"Escape\") open = false;\n    };\n    document.addEventListener(\"mousedown\", away);\n    document.addEventListener(\"keydown\", esc);\n    return () => {\n      document.removeEventListener(\"mousedown\", away);\n      document.removeEventListener(\"keydown\", esc);\n    };\n  });\n</script>\n\n<div class=\"bk-menu\" bind:this={ref}>\n  <Button size=\"sm\" icon=\"down\" iconPosition=\"right\" aria-haspopup=\"menu\" aria-expanded={open} onclick={() => (open = !open)}>\n    {label}\n  </Button>\n  {#if open}\n    <div class=\"bk-menu__list bk-cut\" role=\"menu\">\n      {#each items as it}\n        <button\n          type=\"button\"\n          role=\"menuitem\"\n          class=\"bk-menu__item\"\n          onclick={() => {\n            onPick?.(it);\n            open = false;\n          }}>{it}</button\n        >\n      {/each}\n    </div>\n  {/if}\n</div>\n",
      "type": "registry:ui",
      "target": "dropdown-menu.svelte"
    }
  ]
}
